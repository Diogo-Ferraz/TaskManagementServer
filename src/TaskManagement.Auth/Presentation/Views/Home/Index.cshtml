@using Microsoft.AspNetCore.Authentication

@if (User.Identity?.IsAuthenticated == true)
{
    var authenticationResult = await Context.AuthenticateAsync();
    var issued = authenticationResult?.Properties?.Items.TryGetValue(".issued", out var issuedValue) == true
        ? issuedValue
        : string.Empty;
    var expires = authenticationResult?.Properties?.Items.TryGetValue(".expires", out var expiresValue) == true
        ? expiresValue
        : string.Empty;
    <div>
        <p>You are signed in as</p>
        <h2>@(User.Identity?.Name ?? string.Empty)</h2>
        <hr />
        <dl>
            <dt>Issued</dt>
            <dd>@issued</dd>
            <dt>Expires</dt>
            <dd>@expires</dd>
        </dl>
        <hr />
        <p><a class="btn btn-dark" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">Sign out</a></p>
    </div>
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div>
        <p>You are not signed in</p>
        <p><a class="btn btn-sm btn-dark" asp-area="Identity" asp-page="/Account/Login">Sign in</a></p>
    </div>
}
